{
  "name": "open-tag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source, self-hosted alternative to Claude Tag — a Slack-style workspace where humans and AI agents collaborate as teammates in channels, threads and DMs.",
  "license": "Apache-2.0",
  "author": "The open-tag authors",
  "contributors": [
    "fancyboi999 (original project)",
    "f00700f (LazyCat community distribution)"
  ],
  "homepage": "https://github.com/aimdotsh/open-tag-lazycat#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimdotsh/open-tag-lazycat.git"
  },
  "bugs": {
    "url": "https://github.com/aimdotsh/open-tag-lazycat/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "workspace",
    "collaboration",
    "self-hosted",
    "slack",
    "claude",
    "open-source"
  ],
  "scripts": {
    "infra": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed.ts",
    "seed:dev": "tsx src/db/seed-dev.ts",
    "server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "web:build": "npm --prefix web run build",
    "docs:build": "npm --prefix docs-site run build",
    "site:build": "npm run web:build && npm run docs:build",
    "stop": "pkill -f 'src/server/index.ts'; pkill -f 'src/daemon/index.ts'; pkill -f 'bin/vite'; true",
    "start:prod": "ENV_FILE=.env.prod tsx src/server/index.ts",
    "daemon:prod": "set -a && . ./.env.prod && set +a && ENV_FILE=.env.prod tsx src/daemon/index.ts --api-key \"$DAEMON_BOOTSTRAP_KEY\"",
    "db:push:prod": "set -a && . ./.env.prod && set +a && drizzle-kit push",
    "seed:prod": "ENV_FILE=.env.prod tsx src/db/seed.ts",
    "stop:prod": "lsof -ti tcp:7788 -sTCP:LISTEN | xargs kill 2>/dev/null; true",
    "prod:up": "bash scripts/prod-up.sh",
    "prod:down": "bash scripts/prod-down.sh",
    "daemon": "tsx src/daemon/index.ts --api-key poc-secret-key",
    "cli": "tsx src/cli/index.ts",
    "pkg:daemon:build": "node scripts/build-daemon-pkg.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "wt:add": "bash scripts/wt-add.sh",
    "wt:rm": "bash scripts/wt-rm.sh",
    "dev:e2e:up": "bash scripts/dev-e2e-up.sh",
    "dev:e2e:down": "bash scripts/dev-e2e-down.sh"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.0",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.5",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1107.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
