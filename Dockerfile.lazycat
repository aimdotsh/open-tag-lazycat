# syntax=docker/dockerfile:1
# Modified by f00700f for the community-maintained LazyCat distribution, 2026.
FROM node:22-slim AS build
WORKDIR /app
ENV NODE_ENV=development
ENV VITE_LAZYCAT_SSO=true
COPY package.json package-lock.json ./
RUN npm ci
COPY web/package.json web/package-lock.json ./web/
RUN npm --prefix web ci
COPY docs-site/package.json docs-site/package-lock.json ./docs-site/
RUN npm --prefix docs-site ci
COPY . .
RUN npm run site:build \
    && npm run pkg:daemon:build

# Assemble the complete application payload before the final stage so Docker
# emits one application layer. This reduces streaming/conversion work when an
# embedded OCI image is imported into the microserver's Docker daemon.
RUN mkdir -p /runtime/app /runtime/app/releases /runtime/app/scripts /runtime/app/legal /runtime/usr/local/bin \
    && npm pack ./packages/daemon --pack-destination /runtime/app/releases \
    && cp -a node_modules /runtime/app/node_modules \
    && cp -a web/dist /runtime/app/web-dist \
    && cp -a docs-site/dist /runtime/app/docs-site-dist \
    && cp -a src /runtime/app/src \
    && mkdir -p /runtime/app/web /runtime/app/docs-site /runtime/app/packages/daemon \
    && mv /runtime/app/web-dist /runtime/app/web/dist \
    && mv /runtime/app/docs-site-dist /runtime/app/docs-site/dist \
    && cp packages/daemon/package.json /runtime/app/packages/daemon/package.json \
    && cp drizzle.config.ts tsconfig.json package.json /runtime/app/ \
    && cp LICENSE NOTICE UPSTREAM.md MODIFICATIONS.md THIRD_PARTY_NOTICES.md docs/third-party-packages.md /runtime/app/legal/ \
    && mkdir -p /runtime/app/web/dist/legal \
    && cp LICENSE /runtime/app/web/dist/legal/LICENSE.txt \
    && cp NOTICE /runtime/app/web/dist/legal/NOTICE.txt \
    && cp UPSTREAM.md MODIFICATIONS.md THIRD_PARTY_NOTICES.md /runtime/app/web/dist/legal/ \
    && cp docs/third-party-packages.md /runtime/app/web/dist/legal/THIRD_PARTY_PACKAGES.md \
    && cp scripts/wait-for-postgres.mjs /runtime/app/scripts/wait-for-postgres.mjs \
    && cp scripts/docker-entrypoint.sh /runtime/usr/local/bin/docker-entrypoint.sh \
    && chmod +x /runtime/usr/local/bin/docker-entrypoint.sh

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
COPY --from=build --chown=node:node /runtime/ /
USER node
EXPOSE 7788
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||7788)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
